# --- WhatsApp Cloud API (Meta) - línea Rompecabezas B2C ---
# Se obtienen en developers.facebook.com una vez esté creado el Business Manager
# y verificado el número de WhatsApp de Rompecabezas.
WA_ROMPECABEZAS_TOKEN=
WA_ROMPECABEZAS_PHONE_NUMBER_ID=
WA_ROMPECABEZAS_VERIFY_TOKEN=cambia-esto-por-una-clave-tuya

# Puerto donde escucha el servidor (detrás de Nginx con HTTPS en el VPS)
PORT=3000

# Carpeta donde se guardan los pedidos y fotos recibidas (base de datos simple en archivos JSON,
# hasta que se decida migrar a una base de datos real junto con el resto del ERP).
DATA_DIR=./data

# Instrucciones de pago que el bot envía al cliente (Nequi personal, verificación humana)
NEQUI_NUMERO=
NEQUI_TITULAR=

# Clave compartida que debe mandar el Hub (TACTICAL_ERP_HUB.html) para leer /api/pedidos-pendientes.
# Inventa una clave larga y random -- no la publiques, va tanto aquí como en el Hub.
HUB_API_KEY=
